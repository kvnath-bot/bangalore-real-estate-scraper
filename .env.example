# ==============================================================================
# Bangalore Real Estate Scraper - Environment Configuration
# ==============================================================================

# --- AI Search Engines (Zero Cost / Free Tier) ---
# Google Gemini API Key (FREE via https://aistudio.google.com/app/apikey)
# Gives 15 Requests/Min, 1,500 Requests/Day for free
GEMINI_API_KEY=your_gemini_api_key_here

# Perplexity API Key (Optional fallback via https://www.perplexity.ai/settings/api)
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Search Strategy: 'hybrid' (Gemini first with Perplexity fallback), 'gemini', or 'perplexity'
SEARCH_STRATEGY=hybrid

# --- Google Sheets Integration ---
# Title of the Google Sheet (will be created automatically if it doesn't exist)
GOOGLE_SHEET_NAME=Bangalore Real Estate Projects Tracker

# Spreadsheet ID (Optional: if you prefer using the exact URL ID of an existing sheet)
# e.g., https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# SPREADSHEET_ID=

# Google Service Account Credentials:
# Option A: Path to service account JSON file on local machine
GCP_SERVICE_ACCOUNT_FILE=service_account.json

# Option B: Raw JSON string of service account key (Ideal for GitHub Actions Secrets & Render)
# GCP_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# --- Geocoding & Map Pin Links ---
# Set to false to skip the geocoding stage entirely
GEOCODE_ENABLED=true

# Optional. With a key set, the Google Geocoding API is used (fast, billable).
# Leave blank to use the free OpenStreetMap / Nominatim backend at ~1 req/sec.
# GOOGLE_MAPS_API_KEY=

# Geocode lookups spent per run. The sheet itself remembers what is already
# resolved, so a large backlog drains across consecutive daily runs.
GEOCODE_MAX_PER_RUN=400

# --- Google Sheet Sharing ---
# Comma-separated addresses granted access to the tracker after each run
# SHARE_WITH_EMAILS=someone@gmail.com,someone.else@gmail.com
# Access level: reader | commenter | writer
SHARE_ROLE=writer
# Send Drive notification emails when access is first granted
SHARE_NOTIFY=false

# --- Web Service / Render Settings (Optional) ---
PORT=8000
CRON_SECRET=your_secure_cron_webhook_secret_here
